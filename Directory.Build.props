<Project>

  <PropertyGroup>
    <!-- 공통 빌드 속성 -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 버전 (모노 버전: 배포 패키지 모두 동일) -->
    <Version>0.48.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- `dotnet pack -p:IyuPackLine=core|lowline` packs one version line (release.yml passes it); unset packs everything.
         Iyu.Lowline's own props file turns packing back on for the lowline line and off for the core line. -->
    <IsPackable Condition="'$(IyuPackLine)' == 'lowline'">false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NuGet 패키지 메타데이터 -->
    <Authors>iyulab</Authors>
    <Company>iyulab</Company>
    <Product>Iyu Framework v5</Product>
    <Description>iyu-framework-v5: OData + GraphQL runtime framework for .NET 10.</Description>
    <Copyright>Copyright © iyulab</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/iyulab/iyu-framework-v5</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iyulab/iyu-framework-v5</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>iyu;odata;graphql;framework;aspnetcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See CHANGELOG.md, shipped in this package and at https://github.com/iyulab/iyu-framework-v5/blob/main/CHANGELOG.md — every Iyu.* package except Iyu.Lowline (versioned on its own line, with its own changelog) shares one version, so check the "Packages affected" line of each release between your current version and this one.</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- A package carries the short README written for it (package-readmes/<project>.md, packed as README.md); one without falls back to the repository README. -->
    <None Include="$(MSBuildThisFileDirectory)package-readmes/$(MSBuildProjectName).md" Pack="true" PackagePath="README.md" Condition="Exists('$(MSBuildThisFileDirectory)package-readmes/$(MSBuildProjectName).md')" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Condition="!Exists('$(MSBuildThisFileDirectory)package-readmes/$(MSBuildProjectName).md') And Exists('$(MSBuildThisFileDirectory)README.md')" />
    <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildThisFileDirectory)CHANGELOG.md')" />
  </ItemGroup>

</Project>
