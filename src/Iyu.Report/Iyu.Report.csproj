<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Fills Office document templates with data through DocuChef; unrelated to Iyu.VaultAi's scheduled reports.</Description>
    <PackageTags>iyu;office;templates;reporting</PackageTags>
    <RootNamespace>Iyu.Report</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocuChef" Version="0.5.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
  </ItemGroup>

</Project>
