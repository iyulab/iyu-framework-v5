<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Serves entities over OData with cookie and bearer-token identity from one registration call; carries no GraphQL dependency.</Description>
    <PackageTags>iyu;odata;identity;aspnetcore</PackageTags>
    <RootNamespace>Iyu.MainServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iyu.Core\Iyu.Core.csproj" />
    <ProjectReference Include="..\Iyu.Data\Iyu.Data.csproj" />
    <ProjectReference Include="..\Iyu.Server.OData\Iyu.Server.OData.csproj" />
    <!-- GraphQL is not referenced here: it is an optional surface, composed in by Iyu.MainServer.GraphQL, so a host
         that serves only OData carries none of the GraphQL stack (HotChocolate and its IDE package). -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ML layer's read guard asks which surfaces are composed in, to tie a policy declared on a read type to the table
         behind it. -->
    <InternalsVisibleTo Include="Iyu.MainServer.ML" />
  </ItemGroup>

</Project>
