<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Host-neutral notification routing - events declared in code, recipients resolved from users and roles, an inbox with read and handled state, and a record of events nobody could be reached for; it depends on neither Entity Framework Core nor Iyu.Core.</Description>
    <PackageTags>iyu;notifications;inbox;routing</PackageTags>
    <RootNamespace>Iyu.Notifications</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Registration, options and the start-up check need the dependency-injection, options, hosting and logging
         abstractions, the same family and version the other host-neutral modules take. Nothing here reaches for the web
         stack or a data-access library. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Iyu.Tests" />
  </ItemGroup>

</Project>
