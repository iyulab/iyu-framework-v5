<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Entity Framework Core dataset source for Iyu.ML: reads the declared columns of a DbContext set and honors the read guard.</Description>
    <PackageTags>iyu;machine-learning;entityframeworkcore;datasets</PackageTags>
    <RootNamespace>Iyu.ML.EntityFrameworkCore</RootNamespace>
    <!-- Not packed yet, for the same reason as Iyu.ML: it depends on a layer that has not been released, and the pair ship
         together when the first release is decided. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The source reads the application's own DbContext, so the application already references Entity Framework Core;
         this package states the floor it was built against. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iyu.ML\Iyu.ML.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Iyu.Tests" />
  </ItemGroup>

</Project>
