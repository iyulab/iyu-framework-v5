<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Iyu.Ml</RootNamespace>
    <!-- Not packed yet. The product-neutral ML layer ships when its first release is decided; it then sits on its own version
         line like Iyu.Lowline (its own Directory.Build.props, tag and changelog, because it references neither Iyu.Core nor
         a host) and the README layer table gains its row. Until then no pack line may carry it. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The registration entry point and its start-up checks need the dependency-injection, options and hosting
         abstractions, the same family and version the other host-neutral modules already take. Nothing here reaches
         for the web stack or a data-access library. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Iyu.Tests" />
    <!-- The adapter asks whether the layer was turned on, which is not something a caller should be able to fake. -->
    <InternalsVisibleTo Include="Iyu.Ml.EntityFrameworkCore" />
  </ItemGroup>

</Project>
