<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Entity Framework Core stores behind Iyu.Notifications - the inbox, the record of unreached events and the administrators' target table - over the application's own DbContext tables.</Description>
    <PackageTags>iyu;notifications;inbox;entityframeworkcore</PackageTags>
    <RootNamespace>Iyu.Notifications.EntityFrameworkCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The stores read and write through the application's own DbContext, so the application already references Entity
         Framework Core; this package states the floor it was built against. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iyu.Notifications\Iyu.Notifications.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Iyu.Tests" />
  </ItemGroup>

</Project>
