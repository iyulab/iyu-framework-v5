<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Iyu.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <!-- ConsumerNamespaceGuidanceTests compiles a consumer-shaped source file. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <!-- A relational provider where a query's meaning depends on one: an absent reference reads as null (LEFT JOIN),
         where the in-memory provider dereferences it. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iyu.Core\Iyu.Core.csproj" />
    <ProjectReference Include="..\Iyu.Data\Iyu.Data.csproj" />
    <ProjectReference Include="..\Iyu.Data.SqlServer\Iyu.Data.SqlServer.csproj" />
    <ProjectReference Include="..\Iyu.MainServer\Iyu.MainServer.csproj" />
    <ProjectReference Include="..\Iyu.MainServer.GraphQL\Iyu.MainServer.GraphQL.csproj" />
    <ProjectReference Include="..\Iyu.MainServer.OpenIdConnect\Iyu.MainServer.OpenIdConnect.csproj" />
    <ProjectReference Include="..\Iyu.Report\Iyu.Report.csproj" />
    <ProjectReference Include="..\Iyu.FileServer\Iyu.FileServer.csproj" />
    <ProjectReference Include="..\Iyu.DocConvert\Iyu.DocConvert.csproj" />
    <ProjectReference Include="..\Iyu.Server.OData\Iyu.Server.OData.csproj" />
    <ProjectReference Include="..\Iyu.Server.GraphQL\Iyu.Server.GraphQL.csproj" />
    <ProjectReference Include="..\Iyu.Server.Chat\Iyu.Server.Chat.csproj" />
    <ProjectReference Include="..\Iyu.VaultAi\Iyu.VaultAi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ConsumerNamespaceGuidanceTests compiles against the namespace guidance the README
      publishes, and SignInRecipeCompilationTests compiles its sign-in recipes, so both read
      that file rather than a copy kept in test code (ReadmeCompilation). A copy is
      the failure it exists to catch: the two disagree, the suite still passes, and the
      consumer is the one who finds out.
    -->
    <None Include="..\..\README.md" Link="guidance\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      ReleaseNoteMarkingTests reads the changelog for the same reason: the convention it
      checks is published there, and a copy in test code would be the thing to drift.
    -->
    <None Include="..\..\CHANGELOG.md" Link="guidance\CHANGELOG.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
