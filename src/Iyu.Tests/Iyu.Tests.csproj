<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Iyu.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <!-- ConsumerNamespaceGuidanceTests compiles a consumer-shaped source file. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iyu.Core\Iyu.Core.csproj" />
    <ProjectReference Include="..\Iyu.Data\Iyu.Data.csproj" />
    <ProjectReference Include="..\Iyu.MainServer\Iyu.MainServer.csproj" />
    <ProjectReference Include="..\Iyu.Report\Iyu.Report.csproj" />
    <ProjectReference Include="..\Iyu.FileServer\Iyu.FileServer.csproj" />
    <ProjectReference Include="..\Iyu.DocConvert\Iyu.DocConvert.csproj" />
    <ProjectReference Include="..\Iyu.Server.OData\Iyu.Server.OData.csproj" />
    <ProjectReference Include="..\Iyu.Server.GraphQL\Iyu.Server.GraphQL.csproj" />
    <ProjectReference Include="..\Iyu.Server.Chat\Iyu.Server.Chat.csproj" />
    <ProjectReference Include="..\Iyu.VaultAi\Iyu.VaultAi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ConsumerNamespaceGuidanceTests compiles against the namespace guidance the README
      publishes, so it reads that file rather than a copy kept in test code. A copy is
      the failure it exists to catch: the two disagree, the suite still passes, and the
      consumer is the one who finds out.
    -->
    <None Include="..\..\README.md" Link="guidance\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
