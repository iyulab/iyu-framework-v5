<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Runs the Lowline engine, which learns suggestions for form fields from confirmed records, in any .NET host over two storage ports the host provides; it depends on neither Entity Framework Core nor Iyu.Core.</Description>
    <PackageTags>iyu;lowline;forms;suggestions;aspnetcore</PackageTags>
    <RootNamespace>Iyu.Lowline</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The endpoints are ASP.NET Core routes. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine is a native library: the package carries it for Windows, Linux (glibc and musl) and macOS, x64 and arm64.
         The package's tests pass on an x64 Alpine image; arm64 Alpine has not been run (README, "Iyu.Lowline"). -->
    <PackageReference Include="Lowline" Version="0.12.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Iyu.Tests" />
  </ItemGroup>

</Project>
