<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Iyu.Lowline</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The endpoints are ASP.NET Core routes. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine is a native library: the package carries it for Windows, Linux (glibc and musl) and macOS, x64 and arm64.
         Alpine images are not yet exercised with this package (README, "Iyu.Lowline"). -->
    <PackageReference Include="Lowline" Version="0.11.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Iyu.Tests" />
  </ItemGroup>

</Project>
