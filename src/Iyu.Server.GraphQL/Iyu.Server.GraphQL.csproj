<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>HotChocolate GraphQL schema building over read/write entity pairs, for ASP.NET Core.</Description>
    <PackageTags>iyu;graphql;hotchocolate;schema;aspnetcore</PackageTags>
    <RootNamespace>Iyu.Server.GraphQL</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.7.3" />
    <PackageReference Include="HotChocolate.Authorization" Version="16.7.3" />
    <PackageReference Include="HotChocolate.Data.EntityFramework" Version="16.7.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iyu.Core\Iyu.Core.csproj" />
    <ProjectReference Include="..\Iyu.Data\Iyu.Data.csproj" />
  </ItemGroup>

  <!-- Applying a policy to a set or field is the composition layer's act (IyuMainServerOptions.Authorize):
       declared once per entity, enforced by every surface. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Iyu.MainServer.GraphQL" />
    <InternalsVisibleTo Include="Iyu.Tests" />
  </ItemGroup>

</Project>
