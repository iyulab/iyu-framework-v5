<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Iyu.Data.SqlServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.EntityFrameworkCore.SqlServer 10.0.14 asks for SqlClient 6.1.7 or later; this package follows the
         current stable line (7.x) rather than that floor. Azure/Entra ID authentication lives in the separate
         Microsoft.Data.SqlClient.Extensions.Azure package since 7.0 — an application that signs in that way adds it. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- TODO(upstream: Microsoft.Data.SqlClient): raises a transitive dependency past security advisories
         GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx — SqlClient 7.1.1 brings System.Security.Cryptography.Pkcs 9.0.18
         (still affected). Remove once SqlClient carries a patched one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iyu.Data\Iyu.Data.csproj" />
  </ItemGroup>

</Project>
