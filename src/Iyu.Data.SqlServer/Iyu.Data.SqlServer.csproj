<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Iyu.Data.SqlServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The floor Microsoft.EntityFrameworkCore.SqlServer 10.0.13 itself requires: an application on SQL Server already
         has it, and this package does not move it. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <!-- TODO(upstream: Microsoft.Data.SqlClient): raises a transitive dependency past security advisories
         GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx — SqlClient 6.1.7 brings System.Security.Cryptography.Pkcs 9.0.11
         (7.1.1 brings 9.0.18; both affected). Remove once SqlClient carries a patched one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iyu.Data\Iyu.Data.csproj" />
  </ItemGroup>

</Project>
